							"pm.test(\"Status 201\", () => pm.expect(pm.response.code).to.eql(201));\r",
							"pm.test(\"JSON\", () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));\r",
							"pm.test(\"RT < 800ms\", () => pm.expect(pm.response.responseTime).to.be.below(800));\r",
							"\r",
							"const j = pm.response.json();\r",
							"pm.test(\"Envelope ok\", () => {\r",
							"  pm.expect(j).to.have.property(\"status\", \"success\");\r",
							"  pm.expect(j).to.have.property(\"data\");\r",
							"  pm.expect(j).to.have.property(\"error\");\r",
							"});\r",
							"\r",
							"pm.test(\"Member fields ok\", () => {\r",
							"  pm.expect(j.data).to.include.keys([\"id\",\"name\",\"email\",\"created_at\",\"updated_at\"]);\r",
							"});\r",
							"\r",
							"// Lưu member_id để dùng cho Create Loan\r",
							"pm.collectionVariables.set(\"member_id\", j.data.id);\r",
